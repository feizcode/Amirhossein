{% extends 'base.twig' %}
{% block title %}ورود خانواده | کشف{% endblock %}
{% block body %}<main class="gate"><div class="gate-brand"><span>ک</span><h1>کشف</h1><p>دفتر یادگیری امیرحسین</p></div><section class="gate-panel"><div class="gate-kicker">هر روز، یک کشف تازه</div><h2>به فضای خانواده خوش آمدی</h2><p>برای دیدن دفتر و ادامهٔ مسیر، رمز خانواده را وارد کن.</p><form method="post" action="/login"><input type="hidden" name="_csrf" value="{{ csrf }}"><label for="family-password">رمز خانواده</label><input id="family-password" name="password" type="password" autocomplete="current-password" required maxlength="512" autofocus>{% if error %}<p class="gate-error" role="alert">{{ error }}</p>{% endif %}<button type="submit">ورود به کشف</button></form><small>امیرحسین و والدین از یک رمز مشترک استفاده می‌کنند.</small></section></main>{% endblock %}
